DATABASE_URL="postgresql://dev:dev@localhost:5432/local"

DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI=""

# Tells adapter-node to trust the X-Forwarded-For header set by the Nginx reverse proxy
# in production, so event.getClientAddress() returns the real visitor IP instead of
# Nginx's own address. XFF_DEPTH=1 means "trust exactly one proxy hop".
ADDRESS_HEADER="X-Forwarded-For"
XFF_DEPTH="1"