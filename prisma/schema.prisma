generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String  @id
  username           String  @unique
  firstname          String?
  lastname           String?
  passwordHash       String?
  role               Role    @default(Student)
  mustChangePassword Boolean @default(false)

  student       Student?
  teacher       Teacher?
  discordUser   DiscordUser?
  sessions      Session[]
  passkeys      Passkey[]
  comments      Comment[]
  notifications Notification[]
}

model Passkey {
  id         String   @id // WebAuthn credential ID, base64url-encoded
  userId     String
  publicKey  Bytes
  counter    Int
  transports String[]
  deviceType String
  backedUp   Boolean
  name       String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Student {
  id String @id

  courses Course[]

  user User @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Teacher {
  id      String  @id
  isAdmin Boolean @default(false)

  courses Course[]

  user User @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Presentation {
  id              Int     @id @default(autoincrement())
  title           String
  description     String
  chapter         Int
  url             String?
  componentId     String?
  isLocked        Boolean @default(true)
  /// When false, the per-slide comment section doesn't render at all for this presentation
  /// (existing comments are kept, just hidden — see the presentation route's load/createComment).
  commentsEnabled Boolean @default(true)

  courseId Int

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  comments Comment[]
}

model Course {
  id    Int    @id @default(autoincrement())
  name  String
  icon  String
  group Int    @default(1)

  schoolSessionId Int
  teachers        Teacher[]
  students        Student[]
  presentations   Presentation[]
  comments        Comment[]

  schoolSession SchoolSession @relation(fields: [schoolSessionId], references: [id])
}

/// A student or teacher comment anchored to one slide of a presentation (see the stable slide
/// `id` produced by registerInTOC in utils.svelte.ts — slide content itself isn't in the DB, so
/// this is just a free-form string, not a relation).
model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  slideId   String
  /// Only meaningful on a top-level comment (parentId null); set by a teacher of the course to
  /// mark a question as answered. Drives which reply is pinned/highlighted as "the" answer.
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  presentationId Int
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  /// Denormalized from presentation.courseId so a future "comments needing an answer" view can
  /// be queried per course without joining through Presentation.
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Null for a top-level comment (a "question"). Set for a reply — replies are flat (a reply's
  /// parent is never itself a reply), enforced in the createComment action, not here.
  parentId Int?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  notifications Notification[]

  @@index([presentationId, slideId])
  @@index([courseId, resolved])
}

/// One row per (recipient, comment) event. Two triggers only, both created alongside the comment
/// action that causes them (see notification-service.ts): a new top-level comment notifies every
/// teacher of the course; a top-level comment being marked resolved notifies its author.
model Notification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  commentId Int
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

enum NotificationType {
  NewQuestion
  QuestionAnswered
}

model SchoolSession {
  id        Int     @id @default(autoincrement())
  year      Int
  isCurrent Boolean @default(false)

  season  Season
  courses Course[]
}

model Session {
  id        String   @id
  publicId  String   @unique
  userId    String
  name      String
  lastUsed  DateTime
  expiresAt DateTime
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  oauthToken OAuthToken?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthToken {
  sessionId    String   @id @unique
  accessToken  String   @unique
  refreshToken String
  expiresAt    DateTime

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model DiscordUser {
  userId    String @id @unique
  discordId String @unique
  username  String
  avatar    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  Student
  Teacher
  Admin
}

enum Season {
  Fall
  Winter
  Summer
}
